# Kopier denne til .dev.vars (som er gitignorert) når dere trenger den.
#
# .dev.vars er hemmeligheter for LOKAL kjøring. I produksjon settes de samme
# verdiene med `wrangler secret put NAVN`, aldri i wrangler.jsonc, som ligger
# i git og kan leses av alle.
#
# Generér en nøkkel:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signerer sesjons-cookien (src/features/auth/sign.ts). Bytt verdien: den som
# kjenner den, kan lage sin egen cookie og logge inn som hvem som helst.
SESSION_SECRET="bytt-meg-til-en-lang-tilfeldig-streng"

# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:5173"
